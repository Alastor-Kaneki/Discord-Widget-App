<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/replyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/replyHistoryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/loading_message_history"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/replyHistoryProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:indeterminate="true" />

    <ScrollView
        android:id="@+id/replyHistoryScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:fillViewport="true"
        android:padding="14dp">

        <TextView
            android:id="@+id/replyHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/white"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </ScrollView>

    <com.alastorkaneki.discordwidget.RainbowButton
        android:id="@+id/replyRefreshHistory"
        style="@style/Widget.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/refresh_message_history" />

    <com.alastorkaneki.discordwidget.RainbowEditText
        android:id="@+id/replyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/type_message"
        android:inputType="textCapSentences|textMultiLine"
        android:minHeight="88dp"
        android:padding="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/muted" />

    <com.alastorkaneki.discordwidget.RainbowButton
        android:id="@+id/replySend"
        style="@style/Widget.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/send" />

    <com.alastorkaneki.discordwidget.RainbowButton
        android:id="@+id/replyOpenDiscord"
        style="@style/Widget.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/open_discord" />
</LinearLayout>
