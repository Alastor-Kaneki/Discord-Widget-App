<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/replyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <com.alastorkaneki.discordwidget.RainbowEditText
        android:id="@+id/replyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/type_message"
        android:inputType="textCapSentences|textMultiLine"
        android:minHeight="120dp"
        android:padding="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/muted" />

    <com.alastorkaneki.discordwidget.RainbowButton
        android:id="@+id/replySend"
        style="@style/Widget.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/send" />

    <com.alastorkaneki.discordwidget.RainbowButton
        android:id="@+id/replyOpenDiscord"
        style="@style/Widget.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/open_discord" />
</LinearLayout>